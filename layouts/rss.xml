{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Params.news.name }}</title>
    <link>{{ "news/" | absURL }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    <atom:link href="{{ site.Params.news.feed | absURL }}" rel="self" type="application/rss+xml" />
    {{- $news := where (where site.RegularPages "Section" "news") "Params.upstream" "ne" true }}
    {{- $news = where $news "Layout" "ne" "list" }}
    {{- range first 20 $news }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Content | htmlEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
